# Copiar a .env. Se usa para el backend y para PostgreSQL de Docker.
COMUNIDAD_DB_NAME=comunidad_db
COMUNIDAD_DB_USER=comunidad_user
COMUNIDAD_DB_PASSWORD=cambia_esta_clave_local

# Host/puerto para ejecutar Python directamente con PostgreSQL local.
# Docker sustituye el host por comunidad-db y utiliza el puerto interno 5432.
COMUNIDAD_DB_HOST=127.0.0.1
COMUNIDAD_DB_PORT=5432
COMUNIDAD_DB_CONNECT_TIMEOUT=5

# Puerto del backend en el equipo (Docker). Evita ocupar el 8000 del proyecto anterior.
COMUNIDAD_PORT=8001
COMUNIDAD_CORS_ORIGINS=["http://localhost:4200"]

# Contrato JWT propuesto para acordar con UsuarioService: RS256, sub numérico,
# rol ESTUDIANTE/ADMIN, exp, iss y aud. Aquí solo se configura la clave pública.
COMUNIDAD_JWT_PUBLIC_KEY_FILE=config/jwt/usuarios-public.pem
COMUNIDAD_JWT_ISSUER=UsuarioService
COMUNIDAD_JWT_AUDIENCE=ComunidadService
